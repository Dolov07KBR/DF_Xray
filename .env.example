# ---------- панель ----------
PANEL_PORT=8000
# Интерфейс, на котором публикуется порт панели. С HTTPS ставьте 127.0.0.1.
PANEL_BIND=0.0.0.0
# Адрес, по которому панель доступна клиентам (для ссылок подписок).
# Если панель за nginx/Caddy — укажите внешний https-адрес.
DFX_BASE_URL=http://localhost:8000
DFX_ADMIN_USERNAME=admin
# ОБЯЗАТЕЛЬНО смените перед публикацией в интернет
DFX_ADMIN_PASSWORD=change-me-please
DFX_SESSION_TTL_HOURS=168
# 1 — наполнить базу демо-данными (для скриншотов/тестов)
DFX_SEED_DEMO=0
# Панель за обратным прокси (Caddy/nginx): доверять X-Forwarded-Proto/Host
DFX_TRUST_PROXY=1

# ---------- HTTPS (Caddy) ----------
# Профиль tls включает сервис caddy в docker-compose; Caddyfile создаёт install.sh.
# COMPOSE_PROFILES=tls
PANEL_DOMAIN=
ACME_EMAIL=

# ---------- нода ----------
# Токен создаётся в панели: Ноды → Добавить ноду → Конфиг
NODE_TOKEN=
NODE_PORT=443
NODE_POLL=30
NODE_LOG_LEVEL=info
XRAY_VERSION=25.9.11
# Адрес панели изнутри docker-сети (обычно менять не нужно)
PANEL_INTERNAL_URL=http://panel:8000
# Токен второй ноды (если раскомментировали node-nl)
NODE_TOKEN_NL=
